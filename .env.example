# ==================================================
# Enterprise HR Management Platform — Environment Configuration
# ==================================================

# Environment Mode: development | staging | production
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-insecure-key-to-a-50-char-cryptographically-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,backend

# PostgreSQL Database Configuration
POSTGRES_DB=hrm_platform
POSTGRES_USER=hrm_admin
POSTGRES_PASSWORD=hrm_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hrm_admin:hrm_secure_password@postgres:5432/hrm_platform

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Authentication (Simple JWT)
JWT_SECRET_KEY=change-this-jwt-signing-key-for-production-environment
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Internal Machine-to-Machine (M2M) Secrets (Wi-Fi Ingestion Gateway)
WIFI_INGESTION_SERVICE_TOKEN=change-this-random-64-char-hex-token-for-internal-gateway

# CORS & Trusted Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Organization Defaults
DEFAULT_TIMEZONE=UTC
DEFAULT_GRACE_PERIOD_MINUTES=15
DEFAULT_BREAK_DURATION_MINUTES=60
